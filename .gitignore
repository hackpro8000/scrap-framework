# Place files are built from source, never committed
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock

# Wally installs these
Packages/
ServerPackages/
DevPackages/

# Generated by Rojo / luau-lsp
sourcemap.json

# Blender backup saves
*.blend1

# Python bytecode
__pycache__/

# Model engine build cache
.cache/

# Framework build outputs
framework/engine/target/
framework/engine/bin/
framework/uikit/target/

# Model outputs (.glb, textures, previews, screenshots) are rebuilt from model.luau
art/models/*/*
!art/models/*/model.luau
!art/models/*/sketch.png

# Build machine results and upload staging
.standby-results/
/upload-inbox/
/.objects-store/
